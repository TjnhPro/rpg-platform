{
  "name": "@rpg-platform/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run ui:check && tsc -b --force && npm run ui:build",
    "ui:check": "node scripts/check-ui-contract.mjs",
    "ui:build": "tsc --project ui/tsconfig.json --noEmit && vite build --config ui/vite.config.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:preview": "vite preview --config ui/vite.config.ts"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@rpg-platform/runtime-engine": "0.0.0",
    "@rpg-platform/runtime-render": "0.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
